# NubMail API Configuration
EMAIL_API_URL=https://mails.nubcoders.com/api/emails/send-api
EMAIL_API_KEY=your_nubmail_api_key_here
EMAIL_FROM=contact@deblomper.dev
EMAIL_TO=contact@deblomper.dev

# Cloudflare Turnstile
# Public key: compiled into the browser bundle; rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Secret key: runtime only; required for production contact submissions.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# GitHub Stats SVG Service
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=deblomperrr

